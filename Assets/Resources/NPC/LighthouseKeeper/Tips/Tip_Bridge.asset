  id: keeper_tip_bridge
  title: "\u041F\u0440\u043E \u043C\u043E\u0441\u0442\u044B"
  text: 
  icon: {fileID: 0}
  playerText: "\u041A\u0430\u043A \u043C\u043D\u0435 \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u044C
    \u0432\u043E\u0434\u0443?"
  npcText: "\u0414\u043B\u044F \u0443\u0441\u043F\u0435\u0448\u043D\u043E\u0433\u043E
    \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043D\u0438\u044F \u0432\u043E\u0434\u044B
    \u043D\u0430\u0434\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0438\u0437\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
    \u043C\u043E\u0441\u0442. \u041F\u043E\u0441\u0442\u0430\u0432\u044C \u0435\u0433\u043E
    \u043D\u0430 \u0432\u043E\u0434\u0443 \u0438 \u0432\u0443\u0430-\u043B\u044F,
    \u0442\u044B \u043F\u0440\u043E\u0448\u0451\u043B."
