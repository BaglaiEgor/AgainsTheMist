  id: keeper_tip_interaction
  title: "\u0412\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F"
  text: 
  icon: {fileID: 0}
  playerText: "\u041A\u0430\u043A \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0441 \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438 \u0432 \u043C\u0438\u0440\u0435?"
  npcText: "\u0414\u043B\u044F \u0432\u0441\u0435\u0445 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
    \u0441 \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u043C\u0438 \u0432 \u043C\u0438\u0440\u0435
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u041F\u041A\u041C,
    \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043D\u0435 \u043D\u0430\u0434\u043E."
