  id: keeper_tip_furnace
  title: "\u041F\u0435\u0447\u043A\u0430"
  text: 
  icon: {fileID: 0}
  playerText: "\u041A\u0430\u043A \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u043F\u0435\u0447\u043A\u043E\u0439?"
  npcText: "\u0412 \u043F\u0435\u0447\u0438 \u0440\u0443\u0434\u0430 \u0438\u0434\u0435\u0442
    \u0432\u043E \u0432\u0445\u043E\u0434, \u0443\u0433\u043E\u043B\u044C \u0438\u043B\u0438
    \u0434\u0435\u0440\u0435\u0432\u043E \u0432 \u0442\u043E\u043F\u043B\u0438\u0432\u043E,
    \u0430 \u0433\u043E\u0442\u043E\u0432\u043E\u0435 \u0437\u0430\u0431\u0438\u0440\u0430\u0439
    \u0438\u0437 \u0432\u044B\u0445\u043E\u0434\u0430."
