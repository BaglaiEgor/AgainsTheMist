  title: "\u041A\u043E\u043D\u0435\u0446?"
  text: 
  icon: {fileID: 0}
  playerText: "\u0427\u0442\u043E \u0434\u0430\u043B\u044C\u0448\u0435?"
  npcText: "\u0422\u0443\u043C\u0430\u043D \u043F\u043E\u0431\u0435\u0436\u0434\u0451\u043D,
    \u043D\u0443\u0436\u0434\u044B \u0432 \u043D\u0430\u0441 \u0442\u0443\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
    \u043D\u0435\u0442, \u043D\u043E \u043C\u043E\u0436\u0435\u0448\u044C \u0437\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u044D\u0442\u043E\u0442 \u043E\u0441\u0442\u0440\u043E\u0432"
