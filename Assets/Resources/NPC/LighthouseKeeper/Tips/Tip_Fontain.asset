  id: keeper_tip_middle
  title: "\u041E\u0441\u0442\u043E\u0432 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435"
  text: 
  icon: {fileID: 0}
  playerText: "\u0427\u0442\u043E \u0437\u0430 \u0444\u043E\u043D\u0442\u0430\u043D
    \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0435
    \u0441\u043D\u0438\u0437\u0443?"
  npcText: "\u0421\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u0439 \u0444\u043E\u043D\u0442\u0430\u043D.
    \u0415\u0441\u043B\u0438 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043C\u043E\u043D\u0435\u0442,
    \u0442\u043E \u043E\u043D \u0449\u0435\u0434\u0440\u043E \u0432\u043E\u0437\u043D\u0430\u0433\u0440\u0430\u0434\u0438\u0442,
    \u0434\u0430\u0436\u0435 \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u0441 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F\u043C\u0438"
